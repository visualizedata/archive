---
import MainLayout from '@/layouts/MainLayout.astro'
import { CohortsSection } from '@/components/CohortsSection'
import { readFile } from 'fs/promises'
import { join } from 'path'
import partnersData from '@/data/partners.json'

const base = import.meta.env.BASE_URL

// Helper function to convert faculty name to URL slug
const facultyToSlug = (name: string) => {
  return name.toLowerCase().replace(/\s+/g, '-')
}

// Faculty data with their names
const faculty = [
  'Richard The',
  'Daniel Sauter', 
  'Sam Lavigne',
  'Zach Krall',
  'Jonathan Thirkield',
  'Thiago Hersan',
  'Maria Massei-Rosato'
]

// Load cohort data server-side
async function loadCohortData() {
  const cohortData: { [year: number]: string[] } = {}
  const years = [2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025]
  
  for (const year of years) {
    try {
      const filePath = join(process.cwd(), 'src', 'data', 'projects', `thesis_${year}.json`)
      const fileContent = await readFile(filePath, 'utf-8')
      const projects = JSON.parse(fileContent)
      
      const names = projects
        .map((project: any) => project.author?.[0])
        .filter((name: string) => name)
        .sort((a: string, b: string) => a.localeCompare(b))
      
      if (names.length > 0) {
        cohortData[year] = names
      }
    } catch (error) {
      // File doesn't exist or other error, skip this year
      console.log(`No thesis data found for ${year}`)
    }
  }
  
  return cohortData
}

const cohortData = await loadCohortData()

// Debug: log the cohort data
console.log('Cohort data loaded:', Object.keys(cohortData), 'Total years:', Object.keys(cohortData).length)
for (const [year, names] of Object.entries(cohortData)) {
  console.log(`${year}: ${names.length} students`, names.slice(0, 3))
}
---

<MainLayout title="About">
  <div class="px-4 md:px-8 lg:px-16 max-w-6xl mx-auto">
    
    {/* Main Description Text */}
    <section class="mt-20 mb-16">
      <div class="text-left">
        <p class="text-3xl">
          The Master's in Data Visualization at Parsons is a multidisciplinary degree
          that brings together visual design, computer science, statistical analysis,
          and ethical considerations of data representation.
        </p>
        <p class="text-3xl mb-16">
          The program responds to the increased demand for experts who can turn
          data into insight. You learn to understand and develop the ways in which
          the presentation of data shapes opinion, policy, and decision making in
          today's information economy.
        </p>
      </div>

      {/* Faculty Row */}
      <div class="grid grid-cols-[100px_1fr] items-start gap-8 text-base mb-16">
        <div class="font-bold">Faculty</div>
        <div class="flex flex-wrap gap-x-10 gap-y-4">
          {faculty.map((name) => (
            <a
              href={`https://www.newschool.edu/parsons/faculty/${facultyToSlug(name)}/`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-black/50 hover:text-black transition-colors duration-200"
            >
              {name}
            </a>
          ))}
        </div>
      </div>

      {/* Partners Row */}
      <div class="grid grid-cols-[100px_1fr] items-start gap-8 text-base">
        <div class="font-bold">Partners</div>
        <div class="flex flex-wrap items-center gap-16">
          {partnersData.map((partner) => {
            const logoSrc = `${base}/images/partners/${partner.logo}`
            const content = (
              <img
                src={logoSrc}
                alt={partner.alt}
                class="max-h-12 w-auto object-contain grayscale hover:grayscale-0 transition-all duration-200 opacity-70 hover:opacity-100"
              />
            )
            
            // If partner has a tag, make it clickable to filter projects
            if (partner.tag) {
              return (
                <a 
                  href={`${base}/?q=${encodeURIComponent(partner.tag)}`}
                  class="block"
                  title={`View ${partner.name} projects`}
                >
                  {content}
                </a>
              )
            }
            
            // Otherwise just show the logo
            return (
              <div class="cursor-default">
                <img
                  src={logoSrc}
                  alt={partner.alt}
                  class="max-h-12 w-auto object-contain grayscale opacity-70"
                />
              </div>
            )
          })}
        </div>
      </div>
    </section>

    {/* Cohorts Section - Data Driven */}
    <CohortsSection cohortData={cohortData} client:load />

  </div>
</MainLayout>