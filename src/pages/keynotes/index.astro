---
import MainLayout from '@/layouts/MainLayout.astro'
import { getCollection } from 'astro:content'

const base = import.meta.env.BASE_URL

const keynotes = await getCollection('keynotes').then((k) =>
  k.map((k) => k.data).sort((a, b) => b.year - a.year)
)

// Get first thesis image for each year
const getFirstThesisImage = async (year: number) => {
  try {
    const thesisData = await import(`../../data/projects/thesis_${year}.json`)
    const firstProject = thesisData.default[0]
    return firstProject?.image?.[0] || null
  } catch {
    return null
  }
}

// Get thumbnail images for all keynote years
const keynoteImages = await Promise.all(
  keynotes.map(async (keynote) => ({
    year: keynote.year,
    image: await getFirstThesisImage(keynote.year)
  }))
)

const keynoteImagesMap = Object.fromEntries(
  keynoteImages.map(item => [item.year, item.image])
)
---

<MainLayout title="Keynotes">
  <div class="grid grid-cols-2 gap-4">
    {
      keynotes.map((keynote) => {
        const thumbnailImage = keynoteImagesMap[keynote.year]
        const dateTimeLocation = [
          keynote.date ? new Date(keynote.date).toLocaleDateString(undefined, { 
            month: 'long', 
            day: 'numeric',
            year: 'numeric'
          }) : null,
          keynote.time,
          keynote.location
        ].filter(Boolean).join(' • ')
        
        return (
          <a
            href={`${base}/keynotes/${keynote.year}`}
            class="group block hover:opacity-90 transition-opacity"
          >
            {/* Image thumbnail */}
            <div class="aspect-video rounded-[10px] overflow-hidden bg-gray-100 mb-3">
              {thumbnailImage && (
                <img
                  src={`${base}/images/${thumbnailImage}`}
                  alt={`${keynote.year} Keynote`}
                  class="w-full h-full object-cover"
                />
              )}
              {!thumbnailImage && (
                <div class="w-full h-full bg-gray-200" />
              )}
            </div>
            
            {/* Text information below */}
            <div class="text-black">
              <h2 class="text-sm md:text-base font-bold leading-tight mb-1">
                {keynote.year} Keynotes
              </h2>
              {dateTimeLocation && (
                <p class="text-sm md:text-base text-gray-600 leading-tight">
                  {dateTimeLocation}
                </p>
              )}
            </div>
          </a>
        )
      })
    }
  </div>
</MainLayout>
