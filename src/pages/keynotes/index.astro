---
import MainLayout from '@/layouts/MainLayout.astro'
import { getCollection } from 'astro:content'

const base = import.meta.env.BASE_URL

const keynotes = await getCollection('keynotes').then((k) =>
  k.map((k) => k.data).sort((a, b) => b.year - a.year)
)

// Extract Vimeo video ID from embed HTML and get thumbnail
const getVimeoThumbnail = (videoEmbedHtml: string) => {
  try {
    const match = videoEmbedHtml.match(/vimeo\.com\/video\/(\d+)/)
    if (match && match[1]) {
      const videoId = match[1]
      // Use Vimeo's thumbnail API - returns the largest available thumbnail
      return `https://vumbnail.com/${videoId}.jpg`
    }
  } catch {
    // If parsing fails, return null
  }
  return null
}

// Get thumbnail images for all keynote years
const keynoteImages = keynotes.map((keynote) => ({
  year: keynote.year,
  thumbnail: getVimeoThumbnail(keynote.video_embed_html)
}))

const keynoteImagesMap = Object.fromEntries(
  keynoteImages.map(item => [item.year, item.thumbnail])
)
---

<MainLayout title="Keynotes">
  <div class="grid grid-cols-2 gap-6">
    {
      keynotes.map((keynote) => {
        const thumbnailImage = keynoteImagesMap[keynote.year]
        const dateTimeLocation = [
          keynote.date ? new Date(keynote.date).toLocaleDateString(undefined, { 
            month: 'long', 
            day: 'numeric',
            year: 'numeric'
          }) : null,
          keynote.time,
          keynote.location
        ].filter(Boolean).join(' • ')
        
        return (
          <a
            href={`${base}/keynotes/${keynote.year}`}
            class="group block hover:opacity-90 transition-opacity"
          >
            {/* Video thumbnail */}
            <div class="aspect-video rounded-[10px] overflow-hidden bg-gray-100 mb-3 border border-gray-300">
              {thumbnailImage && (
                <img
                  src={thumbnailImage}
                  alt={`${keynote.year} Keynote`}
                  class="w-full h-full object-cover"
                />
              )}
              {!thumbnailImage && (
                <div class="w-full h-full bg-gray-200" />
              )}
            </div>
            
            {/* Text information below */}
            <div class="text-black">
              <h2 class="text-sm md:text-base font-bold leading-tight mb-1">
                {keynote.year} Keynotes
              </h2>
              {dateTimeLocation && (
                <p class="text-sm md:text-base text-gray-600 leading-tight">
                  {dateTimeLocation}
                </p>
              )}
            </div>
          </a>
        )
      })
    }
  </div>
</MainLayout>
