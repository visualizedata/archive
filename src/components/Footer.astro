---
import TNSLogo from '../assets/tns-logo.svg'
const currentYear = new Date().getFullYear()
---

<footer class="text-gray-900 px-8 py-4">
  <div
    class="wrapper w-container m-auto max-w-full py-8 space-y-8"
  >
    <div class="footer-row space-y-8 lg:space-y-0 lg:grid lg:grid-cols-3">
      <div class="footer-col pr-4">
        <ul>
          <!-- <li class="text-gray-900 font-medium">Information</li> -->
          <li>
            <a
              href="http://www.newschool.edu/parsons/ms-data-visualization/"
              class="text-black hover:text-black/30 font-bold uppercase"
              target="_blank"
              rel="noopener noreferrer"
              >MS Data Visualization</a>
          </li>
          <li>
            <a
              href="http://www.newschool.edu/parsons/art-media-technology-school-amt/"
              class="text-black hover:text-black/30 font-bold uppercase"
              target="_blank"
              rel="noopener noreferrer"
              >School of Art, Media and Technology</a>
          </li>
          <li>
            <a
              href="https://www.newschool.edu/parsons/"
              class="text-black hover:text-black/30 font-bold uppercase"
              target="_blank"
              rel="noopener noreferrer"
              >Parsons School of Design</a>
          </li>
          <li class="text-black font-bold uppercase">
            2 W. 13th St.
            New York, NY 10011
          </li>
        </ul>
      </div>
      <div class="footer-col pr-4">
        <ul>
          <!-- <li class="text-gray-900 font-medium">Social Media</li> -->
          <li>
            <a
              href="https://github.com/visualizedata"
              class="text-black hover:text-black/30 font-bold uppercase"
              target="_blank"
              rel="noopener noreferrer"
              >GitHub</a>
          </li>
          <li>
            <a
              href="https://www.instagram.com/parsons_dv/"
              class="text-black hover:text-black/30 font-bold uppercase"
              target="_blank"
              rel="noopener noreferrer"
              >Instagram</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="footer-row space-y-8 lg:space-y-0 lg:grid lg:grid-cols-4">
      <div class="footer-col font-bold text-black">
        &copy; {currentYear} The New School
      </div>
    </div>
  </div>
</footer>
